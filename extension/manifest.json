{
  "manifest_version": 3,
  "name": "BarelySocial",
  "version": "0.1.0",
  "description": "Redes sociales sin scroll: solo lo que sigues, mensajes y búsqueda. Bloquea Reels/Shorts/For You/Explore/ads.",
  "permissions": ["storage", "declarativeNetRequest", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://*.youtube.com/*",
    "https://*.reddit.com/*",
    "https://*.linkedin.com/*",
    "https://*.tiktok.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ads_tracking", "enabled": true, "path": "rules/dnr.json" }
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://*.instagram.com/*"],
      "js": ["lib/sites.js", "lib/core.js", "sites/instagram.js"],
      "css": ["rules/instagram.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["ads.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["lib/sites.js", "lib/core.js", "sites/youtube.js"],
      "css": ["rules/youtube.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://*.reddit.com/*"],
      "js": ["lib/sites.js", "lib/core.js", "sites/reddit.js"],
      "css": ["rules/reddit.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://*.linkedin.com/*"],
      "js": ["lib/sites.js", "lib/core.js", "sites/linkedin.js"],
      "css": ["rules/linkedin.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://*.tiktok.com/*"],
      "js": ["lib/sites.js", "lib/core.js", "sites/tiktok.js"],
      "css": ["rules/tiktok.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "background": {
    "scripts": ["lib/sites.js", "background.js"],
    "persistent": false
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "BarelySocial"
  }
}
